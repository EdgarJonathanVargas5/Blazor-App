                                        <Authorized>
                                            <li class="flex">
                                                <a rel="noopener noreferrer" href="/user-overview"
                                                    class="flex items-center px-4 dark:border- hover:dark:text-violet-600 hover:dark:border-violet-600 transition-colors">
                                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
