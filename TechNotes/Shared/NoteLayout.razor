                                                        </path>
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z">
                                                        </path>
                                                    </svg>
                                                    Usuarios
                                                </a>
                                            </li>
                                        </Authorized>
                                    </AuthorizeView>
                                </ul>
                            </nav>

                            <div class="flex items-center gap-4">
                                <div class="sm:flex sm:gap-4">
                                    <a class="rounded-md bg-gradient-to-br from-red-500 to-red-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm"
                                        href="/logout">
                                        Cerrar sesión
                                    </a>
                                </div>

                                <div class="block md:hidden">
                                    <button class="rounded-sm bg-gray-100 p-2 text-gray-600 transition hover:text-gray-600/75">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="flex-1 md:flex md:items-center md:gap-12">
                            <a class="block text-teal-600" href="#">
                                <span class="sr-only">Home</span>
