                                </svg>
                            </a>
                        </div>

                        <div class="md:flex md:items-center md:gap-12">
                            
                            <nav aria-label="Global" class="hidden md:block">
                                <ul class="flex items-center gap-6 text-sm">
                                    
                                    <li>
                                        <a class="text-gray-500 transition hover:text-gray-500/75" href="#"> Inicio </a>
                                    </li>

                                    <li>
                                        <a class="text-gray-500 transition hover:text-gray-500/75" href="/notes"> Notas </a>
                                    </li>

                                    <li>
                                        <a class="text-gray-500 transition hover:text-gray-500/75" href="#"> Acerca de </a>
                                    </li>

                                    <li>
                                        <a class="text-gray-500 transition hover:text-gray-500/75" href="#"> Contacto </a>
                                    </li>
                                </ul>
                            </nav>

                            <div class="flex items-center gap-4">
                                <div class="sm:flex sm:gap-4">
                                    <a class="rounded-md bg-gradient-to-br from-blue-500 to-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm"
                                        href="/login">
                                        Iniciar sesión
                                    </a>

                                    <div class="hidden sm:flex">
                                        <a class="rounded-md bg-gray-100 px-5 py-2.5 text-sm font-medium text-teal-600"
                                            href="/register">
                                            Registrarse
                                        </a>
                                    </div>
                                </div>

                                <div class="block md:hidden">
                                    <button class="rounded-sm bg-gray-100 p-2 text-gray-600 transition hover:text-gray-600/75">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24"
                                            stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>
    <main class="flex-1 flex items-center justify-center px-4 py-2">
        <div class="w-full max-w-7xl mx-auto">
            @Body
        </div>
    </main>
    <footer class="bg-gray-800 text-white py-2">
        <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-lg font-semibold mb-4">TechNotes</h3>
                    <p class="text-gray-300 text-sm">Una aplicación moderna para gestionar tus notas técnicas de manera
                        eficiente.</p>
                </div>
                <div>
                    <h4 class="text-md font-semibold mb-4">Enlaces</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="text-gray-300 hover:text-white transition">Inicio</a></li>
                        <li><a href="/notes" class="text-gray-300 hover:text-white transition">Notas</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition">Acerca de</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition">Contacto</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-md font-semibold mb-4">Tecnologías</h4>
                    <ul class="space-y-2 text-sm text-gray-300">
                        <li>.NET & Blazor</li>
                        <li>Entity Framework Core</li>
                        <li>SQL Server</li>
                        <li>Tailwind CSS</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-6 text-center">
                <p class="text-gray-400 text-sm">&copy; 2026 TechNotes. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>
</div>